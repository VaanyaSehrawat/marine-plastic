# config/toolchain.env -- single source of truth for pinned tool versions.
# Sourced by setup.sh and scripts/*.sh. Plain KEY=VALUE shell syntax (bash 3.2 safe).
# Checksums below were read from the publishers' GitHub release pages on 2026-11-03.

# --- JDK 21 LTS (Eclipse Temurin), installed project-locally in .tools/jdk-21 ---
JDK_VERSION="21.0.13+9"
JDK_TAG_URLENC="jdk-21.0.13%2B9"
JDK_FILE_MAC_ARM64="OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.13_9.tar.gz"
JDK_SHA256_MAC_ARM64="bf036b35b071bfb2f54f2c0af8ee8d88afa95ee6eb3dce02c0f94cfc2524d04a"
JDK_FILE_LINUX_X64="OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz"
JDK_SHA256_LINUX_X64="d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c"
JDK_BASE_URL="https://github.com/adoptium/temurin21-binaries/releases/download"

# --- uv (Astral) : used only to fetch a private Python and create the venv ---
UV_VERSION="0.13.7"
UV_FILE_MAC_ARM64="uv-aarch64-apple-darwin.tar.gz"
UV_SHA256_MAC_ARM64="81b811b57e4624df7ed3aac148e0359100d9962f3d9dce00aec533dc2e086731"
UV_FILE_LINUX_X64="uv-x86_64-unknown-linux-gnu.tar.gz"
UV_SHA256_LINUX_X64="c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83"
UV_BASE_URL="https://github.com/astral-sh/uv/releases/download"

# --- Python (managed by uv, never touches system Python) ---
PYTHON_SERIES="3.12"

# --- ONNX Runtime Java (Maven Central). Must match requirements/base.txt onnxruntime pin. ---
# 1.20.1 was never published for Java on Maven Central (HTTP 404); 1.20.0 was verified on the student's Mac:
# download OK and the jar contains osx-aarch64/libonnxruntime.dylib + libonnxruntime4j_jni.dylib.
ORT_VERSION="1.20.0"
# The two settings below can be overridden from the environment (used only by developer tests).
ORT_MAVEN_BASE="${ORT_MAVEN_BASE:-https://repo1.maven.org/maven2/com/microsoft/onnxruntime/onnxruntime}"
# SHA-256 of onnxruntime-1.20.0.jar, computed on the student's Mac (2026-11-05). Enforced on every run.
ORT_JAR_SHA256="${ORT_JAR_SHA256:-c46608681692b3693914defb42fa3119ad7cb6146870581ece247e0ed5793fe8}"

# --- Resource requirements ---
MIN_FREE_GB=6
